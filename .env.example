# Copy this file to .env and fill in your own key. Never commit .env.
GEMINI_API_KEY=your_key_here

# Alternative name accepted by the app (use only one):
# GOOGLE_API_KEY=your_key_here

# Optional tuning
# JOBMATCH_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
# JOBMATCH_JOB_MODEL=gemini-3.5-flash-lite
# JOBMATCH_CHECKPOINT_DB=data/checkpoints.sqlite
# JOBMATCH_CACHE_DB=data/cache.sqlite
# JOBMATCH_CACHE_TTL=86400
# JOBMATCH_RUBRIC_PATH=data/rubrics/role_rubric.sample.json
# JOBMATCH_CHECKPOINT_BACKEND=sqlite
# JOBMATCH_DATABASE_URL=postgresql://user:pass@host:5432/jobmatch
# JOBMATCH_RECURSION_LIMIT=20
# JOBMATCH_MODEL_TIMEOUT=30
